# SMS_PROVIDER=telnyx (default) or twilio, see the bottom of this file.
# Telnyx (Mission Control portal). Never commit real values.
TELNYX_API_KEY=
# Keys & Credentials > Public Key (base64). Used to verify webhook signatures.
TELNYX_PUBLIC_KEY=
# Your Telnyx number in E.164, on a messaging profile
TELNYX_FROM_NUMBER=+15550100100
# Optional: send from a number pool / messaging profile instead
TELNYX_MESSAGING_PROFILE_ID=
# Public https URL Telnyx should send delivery receipts to
WEBHOOK_URL=https://your-tunnel.example.com/telnyx/webhook

# Claude writes replies to inbound texts
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_ENABLED=1
MAX_REPLY_SEGMENTS=2
# AI disclosure (EU AI Act Art. 50): starts the first AI text of each conversation and every hand-over.
# {business} is filled in. Left empty, this default is used.
AI_DISCLOSURE="I'm an AI assistant for {business}."
# Only set this (date + who asked) if the client asked IN WRITING to remove the disclosure.
AI_DISCLOSURE_REMOVED_BY_WRITTEN_REQUEST=

# Guards
BUSINESS_NAME=Brightside Dental
TIMEZONE=America/New_York
QUIET_HOURS=21:00-08:00
PER_CONTACT_PER_HOUR=5
GLOBAL_PER_MINUTE=30
DAILY_SPEND_CAP_USD=2.00
COST_PER_SEGMENT_USD=0.004

# Admin endpoints (/messages, /contacts, /trail, /send) need this as a bearer token
ADMIN_TOKEN=
DB_PATH=var/sms.db
# DRY_RUN=1 records messages without sending; ALLOW_UNSIGNED=1 only for local development
DRY_RUN=0
ALLOW_UNSIGNED=0

# --- Twilio instead of Telnyx ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=            # from a secret store at start-up, never committed
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+447700900100
# TWILIO_MESSAGING_SERVICE_SID=  # optional, instead of TWILIO_FROM_NUMBER
# PUBLIC_BASE_URL=https://your-tunnel.example.com   # Twilio signs the public URL; status callbacks go to /twilio/status
# PROVIDER_ANSWERS_KEYWORDS=auto # auto: Twilio answers STOP itself on +1 numbers; yes/no to override
# TWILIO_TRIAL_TEMPLATE=         # TRIAL ONLY, e.g. sms_customer_support; leave empty on a paid account
