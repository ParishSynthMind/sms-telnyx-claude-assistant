# Telnyx (Mission Control portal). Never commit real values.
TELNYX_API_KEY=
# Keys & Credentials > Public Key (base64). Used to verify webhook signatures.
TELNYX_PUBLIC_KEY=
# Your Telnyx number in E.164, on a messaging profile
TELNYX_FROM_NUMBER=+15550100100
# Optional: send from a number pool / messaging profile instead
TELNYX_MESSAGING_PROFILE_ID=
# Public https URL Telnyx should send delivery receipts to
WEBHOOK_URL=https://your-tunnel.example.com/telnyx/webhook

# Claude writes replies to inbound texts
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_ENABLED=1
MAX_REPLY_SEGMENTS=2

# Guards
BUSINESS_NAME=Brightside Dental
TIMEZONE=America/New_York
QUIET_HOURS=21:00-08:00
PER_CONTACT_PER_HOUR=5
GLOBAL_PER_MINUTE=30
DAILY_SPEND_CAP_USD=2.00
COST_PER_SEGMENT_USD=0.004

# Admin endpoints (/messages, /contacts, /trail, /send) need this as a bearer token
ADMIN_TOKEN=
DB_PATH=var/sms.db
# DRY_RUN=1 records messages without sending; ALLOW_UNSIGNED=1 only for local development
DRY_RUN=0
ALLOW_UNSIGNED=0
